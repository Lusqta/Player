<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161616"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLyricsTrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Letras da Música"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLyricsSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sincronizado (.LRC)"
                android:textColor="#00E676"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLyricsClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#333333"
            android:text="Fechar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E"
        android:layout_marginBottom="12dp" />

    <!-- Lyrics Scroll Area -->
    <ScrollView
        android:id="@+id/scrollLyrics"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layoutLyricsLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="64dp">

            <TextView
                android:id="@+id/tvLyricsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="Nenhuma letra sincronizada (.lrc) ou embutida encontrada para esta faixa.\n\nColoque um arquivo com o mesmo nome e extensão .lrc na mesma pasta da música."
                android:textColor="#777777"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvLyricsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:text="💡 Dica: Toque em qualquer linha da letra para pular a música até aquele instante!"
        android:textColor="#666666"
        android:textSize="11sp" />

</LinearLayout>
