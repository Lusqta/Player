<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#121212">

    <!-- 1. TELA DA BIBLIOTECA -->
    <LinearLayout
        android:id="@+id/layoutLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Biblioteca de Música"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Campo de Pesquisa em Tempo Real -->
        <EditText
            android:id="@+id/etSearchTracks"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="#222222"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="🔍 Buscar músicas, álbuns, artistas..."
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:inputType="text" />

        <!-- Abas de Categorias da Biblioteca (Poweramp Categories Map) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTabTracks"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Músicas"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Pastas"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabAlbums"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Álbuns"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabArtists"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Artistas"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabGenres"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Gêneros"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabYears"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Anos"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabComposers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Compositores"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Fila (Queue)"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabPlaylists"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Playlists"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabMostPlayed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Mais Tocadas"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabRecentlyAdded"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Recentes"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTabTopRated"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Favoritas"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSortOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⇅ Ordenar"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Barra de Navegação de Grupo / Subpasta (se navegando dentro de um álbum/pasta) -->
        <LinearLayout
            android:id="@+id/layoutSubHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:background="#1E1E1E"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBackFromGroup"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="← Voltar"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvSubHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Lista Principal (RecyclerView) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Carregando músicas..."
                android:textColor="#888888"
                android:textSize="15sp"
                android:padding="24dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Mini-Player no Rodapé da Biblioteca -->
        <LinearLayout
            android:id="@+id/layoutMiniPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1C"
            android:visibility="gone">

            <!-- Mini Barra de Progresso Fina -->
            <ProgressBar
                android:id="@+id/miniProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="#00E676" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgMiniCover"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:background="#222222"
                    android:contentDescription="Mini Capa"
                    android:src="@android:drawable/ic_media_play" />

                <LinearLayout
                    android:id="@+id/layoutMiniPlayerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Título da faixa"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Artista"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="▶"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. TELA TOCANDO AGORA (Overlay em tela cheia) -->
    <LinearLayout
        android:id="@+id/layoutNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#121212"
        android:fitsSystemWindows="true"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCollapseNowPlaying"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="↓ Biblioteca"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnNpLyrics"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🎙 Letras"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNpSleepTimer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="⏱ Sleep"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNpEqualizer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="EQ"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Detalhes da Faixa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgNpCover"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:background="#202020"
                android:contentDescription="Capa do Álbum"
                android:src="@android:drawable/ic_media_play" />

            <TextView
                android:id="@+id/tvNpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Título da Música"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artista"
                android:textColor="#00E676"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNpAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Álbum"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNpFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Engine C++ Nativa (Oboe)"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Forma de Onda Interativa (Waveform Seekbar estilo Poweramp) -->
        <com.lucas.player.ui.WaveformView
            android:id="@+id/waveformNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp" />

        <!-- Barra de Progresso Seek -->
        <SeekBar
            android:id="@+id/seekBarNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNpCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNpTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Linha de Controles: Shuffle, Prev, Play/Pause, Next, Repeat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNpShuffle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Shuffle"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnNpPrevious"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⏮"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnNpPlayPause"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1.3"
                android:layout_marginEnd="6dp"
                android:text="▶"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnNpNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⏭"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnNpRepeat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Repetir"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
